{
    "name": "vlc",
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/share/aclocal",
        "/share/doc",
        "/share/gtk-doc",
        "/share/info",
        "/share/man",
        "/share/pkgconfig",
        "/lib/cmake",
        "*.la",
        "*.a"
    ],
    "post-install": [
        "mkdir -p /app/share/vlc/extra",
        "ln -s /app/share/vlc/extra/plugins /app/lib/vlc/plugins/extra",
        "rm -f /app/lib/vlc/plugins/plugins.dat",
        "/app/lib/vlc/vlc-cache-gen /app/lib/vlc/plugins"
    ],
    "build-options": {
        "env": {
            "V": "1"
        }
    },
    "modules": [
        "shared-modules/intltool/intltool-0.51.json",
        "shared-modules/glu/glu-9.json",
        {
            "name": "libebml",
            "builddir": true,
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DBUILD_SHARED_LIBS=ON",
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://dl.matroska.org/downloads/libebml/libebml-1.4.7.tar.xz",
                    "sha256": "5b08214f929ee54c6187c370f84235fc9d0f2a2258c4d320d68eae6e2bdfd3f7",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://dl.matroska.org/downloads/libebml/",
                        "version-pattern": "libebml-(1\\.4\\.\\d+)\\.tar\\.xz",
                        "url-template": "https://dl.matroska.org/downloads/libebml/libebml-$version.tar.xz"
                    }
                },
                {
                    "type": "patch",
                    "path": "libvlc/cmake-min-version.patch"
                }
            ]
        },
        {
            "name": "libmatroska",
            "builddir": true,
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DBUILD_SHARED_LIBS=ON",
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://dl.matroska.org/downloads/libmatroska/libmatroska-1.7.2.tar.xz",
                    "sha256": "f3e4d406daf7f1399962c43940e4a87de089474d5bcfbf2e6ca516e98bb87cfc",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://dl.matroska.org/downloads/libmatroska/",
                        "version-pattern": "libmatroska-(1\\.7\\.\\d+)\\.tar\\.xz",
                        "url-template": "https://dl.matroska.org/downloads/libmatroska/libmatroska-$version.tar.xz"
                    }
                },
                {
                    "type": "patch",
                    "path": "libvlc/cmake-min-version.patch"
                }
            ]
        },
        {
            "name": "dav1d",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.videolan.org/videolan/dav1d/1.5.3/dav1d-1.5.4.tar.xz",
                    "sha256": "686616b7c69eb88d44459391ab25cac13b6647a3b288835c5784e71c1514a5c5",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://download.videolan.org/videolan/dav1d/",
                        "version-pattern": "(1\\.5\\.\\d+)/",
                        "url-template": "https://download.videolan.org/videolan/dav1d/$version/dav1d-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "ffmpeg",
            "config-opts": [
                "--enable-pic",
                "--enable-shared",
                "--disable-doc",
                "--disable-static",
                "--enable-gpl",
                "--enable-libvpx",
                "--enable-libmp3lame",
                "--enable-libvorbis",
                "--enable-libopus"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://ffmpeg.org/releases/ffmpeg-4.4.8.tar.xz",
                    "sha256": "c73848c4ae283d9eaee7be3b276affbc3543380483555500d0dd2c9b7e1c39c3",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://ffmpeg.org/releases/",
                        "version-pattern": "ffmpeg-(4\\.4\\.\\d+)\\.tar\\.xz",
                        "url-template": "https://ffmpeg.org/releases/ffmpeg-$version.tar.xz"
                    }
                }
            ]
        },
        {
            "name": "libplacebo",
            "buildsystem": "meson",
            "config-opts": [
                "-Dvulkan=false"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/haasn/libplacebo/archive/refs/tags/v0.2.1.tar.gz",
                    "sha256": "d5d920a1745e4209287d32e8b96a85127b61b843304813980e11104cd9f15e82",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/haasn/libplacebo/releases/latest",
                        "version-query": ".tag_name | sub(\"^v\"; \"\")",
                        "url-query": ".tarball_url"
                    }
                }
            ]
        },
        {
            "name": "vlc",
            "config-opts": [
                "BUILDCC=/usr/bin/gcc -std=gnu99",
                "CFLAGS=-U_FORTIFY_SOURCE",
                "CXXFLAGS=-U_FORTIFY_SOURCE",
                "--disable-archive",
                "--disable-dc1394",
                "--disable-dv1394",
                "--disable-linsys",
                "--disable-dvdread",
                "--disable-dvdnav",
                "--disable-bluray",
                "--disable-opencv",
                "--disable-smbclient",
                "--disable-dsm",
                "--disable-sftp",
                "--disable-nfs",
                "--disable-smb2",
                "--disable-v4l2",
                "--disable-decklink",
                "--disable-vcd",
                "--disable-libcddb",
                "--disable-screen",
                "--disable-vnc",
                "--disable-freerdp",
                "--disable-asdcp",
                "--disable-a52",
                "--disable-sdl-image",
                "--disable-alsa",
                "--disable-qt",
                "--disable-skins2",
                "--disable-ncurses",
                "--disable-goom",
                "--disable-projectm",
                "--disable-vsxu",
                "--disable-avahi",
                "--disable-udev",
                "--disable-mtp",
                "--disable-upnp",
                "--disable-microdns",
                "--disable-secret",
                "--disable-kwallet",
                "--disable-vlc",
                "--disable-lua",
                "--disable-vlm",
                "--disable-debug",
                "--disable-update-check",
                "--disable-maintainer-mode",
                "--disable-dependency-tracking",
                "--disable-sout",
                "--disable-taglib",
                "--disable-fluidlite",
                "--disable-notify",
                "--disable-zvbi",
                "--disable-shout",
                "--disable-mod",
                "--disable-x264",
                "--disable-x265",
                "--disable-spatialaudio",
                "--disable-srt",
                "--disable-live555",
                "--disable-chromecast"
            ],
            "cleanup": [
                "/share/macosx"
            ],
            "post-install": [
                "rm -f ${FLATPAK_DEST}/lib/vlc/plugins/plugins.dat",
                "${FLATPAK_DEST}/lib/vlc/vlc-cache-gen ${FLATPAK_DEST}/lib/vlc/plugins"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://download.videolan.org/videolan/vlc/3.0.23/vlc-3.0.24.tar.xz",
                    "sha256": "e7cab503d1d7d5849b89d2cf0e1ee60d0ef6d012407791b644b9cfc0cc225fdf",
                    "x-checker-data": {
                        "type": "html",
                        "url": "https://download.videolan.org/videolan/vlc/",
                        "version-pattern": "(3\\.0\\.\\d+)/",
                        "url-template": "https://download.videolan.org/videolan/vlc/$version/vlc-$version.tar.xz"
                    }
                },
                {
                    "type": "patch",
                    "path": "libvlc/vlc-ignore-time-for-cache.patch"
                }
            ]
        }
    ]
}
