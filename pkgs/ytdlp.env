#
# Pinned yt-dlp stack vendored into the native Linux packages (.deb and .rpm)
# under /usr/lib/apricus/python, so streaming works identically on every
# distro regardless of the (often stale) system yt-dlp. Same releases as the
# Flatpak (pkgs/flatpak/pypi-deps.json) and Snap builds. Mirrors the pattern
# of pkgs/deno.env. Shell-sourced by pkgs/deb/build-deb.sh and
# pkgs/rpm/build-rpm.sh (do NOT add spaces around '=').
#
# Both wheels are pure-python (py3-none-any): arch-independent, and their
# optional runtime deps (brotli, mutagen, websockets, ...) degrade gracefully
# inside yt-dlp when absent; requests/urllib3 come from the system packages.

YTDLP_VERSION="2026.7.4"
YTDLP_WHEEL="yt_dlp-2026.7.4-py3-none-any.whl"
YTDLP_URL="https://files.pythonhosted.org/packages/f9/8a/cd4c9b02c10c563adfe78118310129641900e1cd6de888cfae2452072696/yt_dlp-2026.7.4-py3-none-any.whl"
YTDLP_SHA256="f11f2b11d5a8ac4059f9bdf29fa4407dc7c6bb00c5097e95ca22a7a9db518266"

YTDLP_EJS_VERSION="0.8.0"
YTDLP_EJS_WHEEL="yt_dlp_ejs-0.8.0-py3-none-any.whl"
YTDLP_EJS_URL="https://files.pythonhosted.org/packages/e3/bd/520769863744b669440a924271a6159ddd82ad5ae26b4ac4d4b69e9f8d44/yt_dlp_ejs-0.8.0-py3-none-any.whl"
YTDLP_EJS_SHA256="79300e5fca7f937a1eeede11f0456862c1b41107ce1d726871e0207424f4bdb4"
