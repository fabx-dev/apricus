import os
import sys
import signal
import locale
import gettext

VERSION = '@VERSION@'
_snap = os.environ.get('SNAP') or ''
pkgdatadir = (_snap + '@pkgdatadir@') if _snap else '@pkgdatadir@'
localedir = (_snap + '@localedir@') if _snap else '@localedir@'

sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
locale.bindtextdomain('apricus', localedir)
locale.textdomain('apricus')
gettext.install('apricus', localedir)

if __name__ == '__main__':
    from apricus.__main__ import main
    sys.exit(main(VERSION, pkgdatadir, localedir))
