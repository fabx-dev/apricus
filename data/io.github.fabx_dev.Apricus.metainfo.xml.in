<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright 2026 Fabrizio (fabx-dev) -->
<component type="desktop-application">
  <id>io.github.fabx_dev.Apricus</id>
  <name>Apricus</name>
  <summary>Live wallpaper for Linux</summary>
  <developer id="io.github.fabx_dev">
    <name translate="no">Fabrizio (fabx-dev)</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>Live wallpaper for the GNOME desktop on Linux — local videos, looping playlists, live streams and interactive web pages. Apricus (lat.) — sunny, warmed by the sun.</p>
    <p>Features a native GTK4 and Libadwaita control center, gapless in-place video switching, visual playlists with drag-and-drop and undo, a live Now Playing dashboard, streaming and web hubs with favorites and 10-second previews, and fast login startup.</p>
  </description>

  <branding>
    <color type="primary" scheme_preference="light">#3e7cd6</color>
    <color type="primary" scheme_preference="dark">#14224b</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/fabx-dev/apricus/v2.0.7/res/apricus-2-library.png</image>
      <caption>Video library with asynchronous thumbnails and monitor selector</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/fabx-dev/apricus/v2.0.7/res/apricus-2-playing.png</image>
      <caption>Looping video playlist with drag-and-drop reorder and shuffle</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/fabx-dev/apricus/v2.0.7/res/apricus-2-now-playing.png</image>
      <caption>Now Playing dashboard with widescreen preview and media details</caption>
    </screenshot>
    <screenshot>
      <image>https://raw.githubusercontent.com/fabx-dev/apricus/v2.0.7/res/apricus-2-streaming.png</image>
      <caption>Streaming hub with saved sources, cached thumbnails and LIVE badge</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="2.0.7" date="2026-10-19" type="stable">
      <description>
        <ul>
          <li>Three-row sidebar status footer: dedicated server status indicator on row 1, live activity with animated equalizer or mode symbolic icon on row 2, and version on row 3</li>
          <li>Keep live wallpaper strictly below Ubuntu DING desktop icons: no-raise window mapping, unconditional EWMH _NET_RESTACK_WINDOW, event-driven stacking guard with media-ready hooks and a 2-second safety net (zero polling timers at startup, negligible steady-state cost)</li>
          <li>Fixed GNOME dock generic gear icon by aligning X11 WM_CLASS with StartupWMClass via GLib.set_prgname</li>
        </ul>
      </description>
    </release>
    <release version="2.0.6" date="2026-10-18" type="stable">
      <description>
        <ul>
          <li>Bundled pinned Deno 2.9.7 and a vendored yt-dlp + yt-dlp-ejs stack in native .deb and .rpm packages, so YouTube streams play out of the box with the same fast path as Snap and Flatpak on every distro</li>
          <li>YouTube failures now report clear actionable errors (missing or outdated yt-dlp) instead of cryptic backend text, and stream resolution failures surface in the playback banner</li>
          <li>Web page wallpapers stay transparent until first paint, revealing the desktop wallpaper instead of a gray flash at autostart</li>
        </ul>
      </description>
    </release>
    <release version="2.0.5" date="2026-10-17" type="stable">
      <description>
        <ul>
          <li>Fixed missing video thumbnails in Snap/Flatpak by bypassing the thumbnailer registry gate and using the direct ffmpeg fallback</li>
          <li>Hardened Web Page wallpapers in Snap with forced software compositing fallback so pages never render white</li>
          <li>Fixed Web Page loading in Snap by adding the network-status plug, granting WebKit access to the proxy-resolver portal (with load-failure diagnostics)</li>
          <li>Replaced lazy module proxies with function-local imports to keep GUI/player cold startup fast without behaviour changes</li>
        </ul>
      </description>
    </release>
    <release version="2.0.4" date="2026-10-17" type="stable">
      <description>
        <ul>
          <li>Faster PC login and GUI cold startup: lazy-loaded yt-dlp and requests imports, zero-subprocess XDG video directory lookup and deferred player window/screensaver handlers</li>
          <li>Eliminated redundant D-Bus/IPC round-trips and duplicate directory scans during GUI startup and refresh</li>
          <li>Singleton DesktopThumbnailFactory and fast MIME lookup for smoother video library browsing</li>
        </ul>
      </description>
    </release>
    <release version="2.0.3" date="2026-10-17" type="stable">
      <description>
        <ul>
          <li>Full Snap confinement support with pre-built VLC plugin cache, bundled Deno 2.9.7 + yt-dlp-ejs and WebKitGTK sandbox compatibility</li>
          <li>High-definition YouTube DASH audio slave routing via avio:// in Snap and automatic yt-dlp client fallback when Deno is absent on native installs</li>
          <li>Persist mute, volume and behaviour flags across restarts when toggled from the desktop context menu or system tray</li>
          <li>Multi-monitor primary display detection fix in monitor_sync and improved Debian (.deb) and Fedora (.rpm) package dependencies</li>
        </ul>
      </description>
    </release>
    <release version="2.0.2" date="2026-10-16" type="stable">
      <description>
        <ul>
          <li>Web Page wallpapers now capture and apply a static wallpaper snapshot and display a live preview in Now Playing</li>
          <li>YouTube stream playback fix using web_embedded client and instant cached hero thumbnail in Now Playing</li>
          <li>Larger 96x54 thumbnails in Streaming rows pre-populated from disk cache without avatar flash</li>
          <li>Flicker-free Library grid when selecting a video and choosing a monitor</li>
        </ul>
      </description>
    </release>
    <release version="2.0.1" date="2026-10-16" type="stable">
      <description>
        <ul>
          <li>Instant monitor chooser on Streaming and Web Page Apply buttons with left-aligned menu items</li>
          <li>Translated monitor chooser entries across all 6 supported languages</li>
          <li>Enriched About dialog with developer details, release notes and credits</li>
          <li>Performance optimizations: in-memory texture and metadata caches, D-Bus bus reuse, flicker-free refresh</li>
        </ul>
      </description>
    </release>
    <release version="2.0.0" date="2026-10-15" type="stable">
      <description>
        <ul>
          <li>New GTK4 and Libadwaita control center (Library, Playlist, Now Playing, Streaming, Web Page, Settings)</li>
          <li>Visual playlist rows with thumbnails, drag-and-drop reorder, shuffle and undo</li>
          <li>Now Playing dashboard with 16:9 hero preview, transport controls, media metadata and Up next queue</li>
          <li>Streaming hub with saved favorites, recent history, lazy thumbnail cache, LIVE badge and 10-second live preview</li>
          <li>Bundled Deno 2.9 runtime and libVLC TLS Fast Open fallback in the Flatpak for reliable HTTPS streaming</li>
          <li>Web Page hub with reachability and title detector, Inspiration presets, favorites and history</li>
          <li>Real-time playback failure banner with Retry action and hop-by-hop SSRF protection</li>
          <li>New application icon and 100% complete translations in English, Italian, German, French, Spanish and Japanese</li>
        </ul>
      </description>
    </release>
    <release version="1.0" date="2026-10-12" type="stable">
      <description>
        <ul>
          <li>First Apricus release (independent evolution of Hidamari)</li>
          <li>Muted looping playlists with dedicated panel tab</li>
          <li>In-place video switching: no respawn gap, painted first frame</li>
          <li>Login-to-first-frame in ~1.4s (static cache, ffprobe sidecar, fast mode)</li>
          <li>User systemd autostart unit and configurable video folder</li>
          <li>Stable per-monitor keys, playlist paused-state, full rebrand</li>
          <li>Interface in English, Italian, German, French, Spanish and Japanese</li>
        </ul>
      </description>
    </release>
  </releases>

  <url type="homepage">https://github.com/fabx-dev/apricus</url>
  <url type="bugtracker">https://github.com/fabx-dev/apricus/issues</url>
  <url type="vcs-browser">https://github.com/fabx-dev/apricus</url>

  <translation type="gettext">apricus</translation>
  <launchable type="desktop-id">io.github.fabx_dev.Apricus.desktop</launchable>
  <provides>
    <binary>apricus</binary>
  </provides>

  <categories>
    <category>Utility</category>
  </categories>
  <keywords>
    <keyword>wallpaper</keyword>
    <keyword>live wallpaper</keyword>
    <keyword>video wallpaper</keyword>
    <keyword>animated wallpaper</keyword>
    <keyword>playlist</keyword>
    <keyword>streaming</keyword>
  </keywords>

  <requires>
    <control>keyboard</control>
    <control>pointing</control>
    <display_length compare="ge">768</display_length>
  </requires>
  <content_rating type="oars-1.1"/>
</component>
